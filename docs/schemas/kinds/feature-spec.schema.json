{
  "type": "object",
  "required": [
    "summary",
    "goals",
    "requirements"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "binding_values": {
      "type": "boolean"
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "game_concept": {
      "type": "string",
      "minLength": 1
    },
    "gameplay_systems": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,5}-[a-z0-9-]+-[0-9]{3}$"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
