{
  "type": "object",
  "required": [
    "game_concept",
    "gameplay_systems",
    "layout",
    "objectives",
    "encounters",
    "rewards",
    "content_refs"
  ],
  "properties": {
    "game_concept": {
      "type": "string",
      "minLength": 1
    },
    "gameplay_systems": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,5}-[a-z0-9-]+-[0-9]{3}$"
      },
      "minItems": 1
    },
    "layout": {
      "type": "string",
      "minLength": 1
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "encounters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "difficulty_curve": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "object",
            "required": [
              "value",
              "status",
              "rationale"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "status": {
                "const": "proposal"
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "content_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,5}-[a-z0-9-]+-[0-9]{3}$"
      }
    }
  },
  "additionalProperties": false
}
