{
  "type": "object",
  "required": [
    "game_concept",
    "gameplay_systems",
    "npc_type",
    "role",
    "behavior",
    "combat_interaction",
    "rewards",
    "content_refs"
  ],
  "properties": {
    "game_concept": {
      "type": "string",
      "minLength": 1
    },
    "gameplay_systems": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,5}-[a-z0-9-]+-[0-9]{3}$"
      },
      "minItems": 1
    },
    "npc_type": {
      "enum": [
        "npc",
        "enemy"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "behavior": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "combat_interaction": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "content_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,5}-[a-z0-9-]+-[0-9]{3}$"
      }
    }
  },
  "additionalProperties": false
}
