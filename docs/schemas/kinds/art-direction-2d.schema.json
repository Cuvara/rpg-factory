{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "2D art direction v1",
  "type": "object",
  "required": [
    "palette",
    "line",
    "shading",
    "proportions",
    "references"
  ],
  "properties": {
    "palette": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "hex"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "hex": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
          }
        },
        "additionalProperties": false
      }
    },
    "line": {
      "type": "string",
      "minLength": 1
    },
    "shading": {
      "type": "string",
      "minLength": 1
    },
    "proportions": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "naming_pattern": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
