{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "2D reference record v1",
  "type": "object",
  "required": [
    "source",
    "license",
    "relevance"
  ],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "relevance": {
      "type": "string",
      "minLength": 1
    },
    "creator": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
