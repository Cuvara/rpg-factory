{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cuvara/rpg-factory/docs/registry.schema.json",
  "title": "rpg-factory registry",
  "description": "Module-level source of truth for Factory Core. Unknown properties are allowed everywhere so future skills can add keys without a schema bump; consumers must ignore keys they do not understand. Enforced by scripts/check-registry.sh.",
  "type": "object",
  "required": [
    "schema_version",
    "workspace",
    "tiers",
    "result_states",
    "tools",
    "repos",
    "modules",
    "global_rules",
    "skills",
    "contracts",
    "human_gates"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "workspace": {
      "type": "object",
      "required": [
        "root_default",
        "root_env",
        "root_markers"
      ],
      "properties": {
        "root_default": {
          "type": "string"
        },
        "root_env": {
          "type": "string"
        },
        "root_markers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "tiers": {
      "type": "object",
      "required": [
        "fast",
        "extended",
        "external"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "result_states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "candidates",
          "version_args"
        ],
        "properties": {
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Tried in order; first found on PATH wins (e.g. dotnet, then dotnet.exe)."
          },
          "version_args": {
            "type": "string"
          },
          "expected": {
            "type": "string",
            "description": "Version CI pins, shown next to the local version."
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "probe"
        ],
        "properties": {
          "probe": {
            "type": "string",
            "pattern": "^tcp://"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "dev_tools": {
      "type": "array",
      "description": "Developer tools (MCP servers, plugins, binaries) the skills use. Probed read-only by lib/devtools.py for the snapshot ('Tools for this change') and /rpg-factory:doctor. Only names are read from MCP/plugin config files.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "probes",
          "provides",
          "used_by",
          "required",
          "fallback"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "mcp",
              "plugin",
              "binary",
              "service"
            ]
          },
          "probes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(bin|tool|service|mcp|plugin):[^|:]+(\\|(bin|tool|service|mcp|plugin):[^|:]+)*$"
            },
            "description": "All probes must pass; '|' separates alternatives inside one probe."
          },
          "provides": {
            "type": "string"
          },
          "used_by": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Skills that name this tool in their ## Tools section (skills-lint enforces both directions)."
          },
          "required": {
            "type": "boolean",
            "description": "true: the skill's fast validation needs it. false: fallback applies."
          },
          "fallback": {
            "type": "string",
            "description": "What a skill does when the tool is not OK (always set; required tools fall back to CI)."
          }
        }
      }
    },
    "global_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "repos": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "default_branch",
          "protected_branches",
          "instructions"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative to the workspace root."
          },
          "remote": {
            "type": "string"
          },
          "default_branch": {
            "type": "string"
          },
          "protected_branches": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Exact names or prefix globs ending in *."
          },
          "branch_pattern": {
            "type": "string"
          },
          "commit_style": {
            "type": "string"
          },
          "merge": {
            "type": "string"
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "embedded_clones": {
            "type": "array",
            "description": "Gitignored nested clones of another registry repo inside this one (user state; never the canonical checkout).",
            "items": {
              "type": "object",
              "required": [
                "path",
                "of"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "of": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "scope",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "description": "Every skill directory under skills/ must be registered here and vice versa (check-registry.sh).",
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "repos",
          "summary",
          "order"
        ],
        "properties": {
          "kind": {
            "enum": [
              "core",
              "repo",
              "cross-repo",
              "tech"
            ],
            "description": "cross-repo skills drive contracts and orchestrate legs; repo skills implement inside one repo. tech skills hold how a technology works in this workspace; never routed as lead/leg, listed in routing.tech for the skills in used_by."
          },
          "repos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "order": {
            "type": "number",
            "description": "Lead precedence tie-break inside a precedence class (lower wins). Unique across skills."
          },
          "used_by": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "tech skills only: the repo/cross-repo skills whose work needs this technology."
          }
        }
      }
    },
    "human_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "match": {
            "type": "string",
            "description": "Python regex applied by the git guard to each Bash command segment inside the workspace."
          },
          "decision": {
            "enum": [
              "ask",
              "deny"
            ],
            "default": "ask"
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "source",
          "copies",
          "driver",
          "gate",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/contract_end"
          },
          "copies": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/contract_end"
            },
            "description": "Ends that must change with the source; touching one routes to the driver."
          },
          "upstream": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/contract_end"
            },
            "description": "Where released versions come from (informational, never routes)."
          },
          "watchers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/contract_end"
            },
            "description": "Other consumers pinned independently (informational, never routes)."
          },
          "driver": {
            "type": [
              "string",
              "null"
            ],
            "description": "Skill that leads when this contract is touched (cross-repo drivers always lead; repo drivers lead when the source is touched)."
          },
          "gate": {
            "type": [
              "string",
              "null"
            ],
            "description": "human_gates id raised by this contract."
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "id",
        "run",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "cwd": {
          "type": "string",
          "description": "Repo-relative working directory. Default '.'."
        },
        "run": {
          "type": "string",
          "description": "Command (fast/extended) or instruction (external). Placeholders: {dotnet}, {plugin_root}."
        },
        "trigger": {
          "type": "string",
          "description": "When an extended check becomes required."
        },
        "evidence": {
          "type": "string",
          "description": "What counts as proof. Must name counts where the tool reports them."
        },
        "parser": {
          "type": "string",
          "description": "How run-checks.py grades the output: go-test | dotnet-test | exit | regex:<pattern> (default inferred from the command)."
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Check ids in the same run that must PASS first; otherwise this check is BLOCKED."
        }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "repo",
        "paths",
        "responsibility",
        "depends_on",
        "checks",
        "rules",
        "generated",
        "tools",
        "obligations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+\\.[a-z0-9-]+$"
        },
        "repo": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Repo-relative prefixes. Trailing / = directory. Longest match wins."
        },
        "responsibility": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Module ids this module consumes. A change in any of them makes this module a dependent that must be validated."
        },
        "claude_md": {
          "type": [
            "string",
            "null"
          ]
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changelog": {
          "type": [
            "string",
            "null"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths (or **/*suffix globs) produced by a generator; never hand-edit."
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "object",
          "required": [
            "fast",
            "extended",
            "external"
          ],
          "properties": {
            "fast": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/check"
              }
            },
            "extended": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/check"
              }
            },
            "external": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/check"
              }
            }
          }
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Skills owning this module (registry.skills keys). Drives Suggested Factory skills."
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "human_gates ids raised when this module is touched."
        },
        "fallback": {
          "type": "boolean",
          "description": "Repository-level catch-all (<repo>.root, paths ['./']): files no other module owns route here instead of 'unmapped'."
        }
      }
    },
    "contract_end": {
      "type": "object",
      "required": [
        "repo",
        "path"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "how": {
          "type": "string"
        }
      }
    }
  }
}
