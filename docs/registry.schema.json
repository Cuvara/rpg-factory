{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cuvara/rpg-factory/docs/registry.schema.json",
  "title": "rpg-factory registry",
  "description": "Module-level source of truth for Factory Core. Unknown properties are allowed everywhere so future skills can add keys without a schema bump; consumers must ignore keys they do not understand. Enforced by scripts/check-registry.sh.",
  "type": "object",
  "required": [
    "schema_version",
    "workspace",
    "tiers",
    "result_states",
    "tools",
    "repos",
    "modules",
    "global_rules",
    "skills",
    "contracts",
    "human_gates",
    "domains"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "workspace": {
      "type": "object",
      "required": [
        "root_default",
        "root_env",
        "root_markers"
      ],
      "properties": {
        "root_default": {
          "type": "string"
        },
        "root_env": {
          "type": "string"
        },
        "root_markers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "tiers": {
      "type": "object",
      "required": [
        "fast",
        "extended",
        "external"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "result_states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "candidates",
          "version_args"
        ],
        "properties": {
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Tried in order; first found on PATH wins (e.g. dotnet, then dotnet.exe)."
          },
          "version_args": {
            "type": "string"
          },
          "expected": {
            "type": "string",
            "description": "Version CI pins, shown next to the local version."
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "probe"
        ],
        "properties": {
          "probe": {
            "type": "string",
            "pattern": "^tcp://"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "dev_tools": {
      "type": "array",
      "description": "Developer tools (MCP servers, plugins, binaries) the skills use. Probed read-only by lib/devtools.py for the snapshot ('Tools for this change') and /rpg-factory:doctor. Only names are read from MCP/plugin config files.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "probes",
          "provides",
          "used_by",
          "required",
          "fallback"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "mcp",
              "plugin",
              "binary",
              "service"
            ]
          },
          "probes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(bin|tool|service|mcp|plugin|plugin-file|codex):[^|:]+(\\|(bin|tool|service|mcp|plugin|plugin-file|codex):[^|:]+)*$"
            },
            "description": "All probes must pass; '|' separates alternatives inside one probe."
          },
          "provides": {
            "type": "string"
          },
          "used_by": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Skills that name this tool in their ## Tools section (skills-lint enforces both directions)."
          },
          "required": {
            "type": "boolean",
            "description": "true: the skill's fast validation needs it. false: fallback applies."
          },
          "fallback": {
            "type": "string",
            "description": "What a skill does when the tool is not OK (always set; required tools fall back to CI)."
          }
        }
      }
    },
    "pipeline": {
      "type": "object",
      "description": "Delivery pipeline settings read by scripts/factory-pipeline.py (policy: skills/factory-core/references/parallel-work.md).",
      "required": [
        "tiers",
        "agents",
        "review_pairing",
        "default_implementer",
        "verdict_states",
        "models"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "tiers": {
          "type": "object",
          "required": [
            "S",
            "M",
            "L"
          ],
          "additionalProperties": {
            "type": "object",
            "properties": {
              "max_repos": {
                "type": "integer"
              },
              "max_modules": {
                "type": "integer"
              },
              "max_files": {
                "type": "integer"
              },
              "max_changed_lines": {
                "type": "integer",
                "description": "Largest committed diff (added plus deleted lines) a task may have at this tier"
              },
              "prose_only": {
                "type": "boolean",
                "description": "true: every owned path of a task must be prose (scripts/lib/pipeline_route.py prose_path)"
              },
              "contracts": {
                "type": "boolean",
                "description": "false: a task that touches a contract is above this tier"
              },
              "generated": {
                "type": "boolean",
                "description": "false: a task that touches a generated path is above this tier"
              },
              "flow": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "agents": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "orca_agent",
              "bin",
              "agent_runner"
            ],
            "properties": {
              "orca_agent": {
                "type": "string",
                "description": "Orca agent id for worker-start --agent"
              },
              "bin": {
                "type": "string",
                "description": "CLI on PATH that proves the agent is installed"
              },
              "agent_runner": {
                "type": "string",
                "description": "Claude Code Agent subagent_type used when Orca is unavailable"
              }
            },
            "additionalProperties": false
          }
        },
        "review_pairing": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "implementer agent -> reviewer agent (always another model)"
        },
        "default_implementer": {
          "type": "string"
        },
        "lead_agent": {
          "type": "string",
          "description": "agent of every task lead (dispatch --phase lead), whatever the task's implementer; default claude"
        },
        "verdict_states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusive_resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "repos",
              "rule"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "repos": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rule": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "no_worktree_markers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "A repo whose root holds one of these files is treated as worktrees: false even when unregistered."
        },
        "agent_routing": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "lead",
              "plan",
              "docs",
              "policy",
              "design",
              "code",
              "test",
              "fix",
              "refactor",
              "generated",
              "default"
            ]
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "qa_prefer": {
          "type": "string"
        },
        "qa_tiers": {
          "type": "object",
          "required": ["task", "integration", "description"],
          "properties": {
            "task": {"const": "affected"},
            "integration": {"enum": ["full", "ci+workspace"]},
            "description": {"type": "string"}
          },
          "additionalProperties": false
        },
        "available_agents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "models": {
          "type": "object",
          "description": "Model policy (scripts/lib/model_policy.py; policy: references/parallel-work.md section 10 'Model choice'). scope = what may run at all; profiles = the model and effort of each role and grade, every one inside scope (scripts/check-registry.sh enforces it). A personal override file may narrow scope and replace profiles.",
          "required": [
            "scope",
            "agent_tool_alias",
            "profiles",
            "default_grade",
            "rubric"
          ],
          "properties": {
            "description": {
              "type": "string"
            },
            "scope": {
              "type": "object",
              "description": "agent -> model id -> allowed efforts",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "agent_tool_alias": {
              "type": "object",
              "description": "model id -> Claude Code Agent tool model alias (the Agent tool cannot set effort)",
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "opus",
                  "sonnet",
                  "haiku"
                ]
              }
            },
            "profiles": {
              "type": "object",
              "description": "agent -> role or grade -> model and effort; every agent in scope has all of planner, lead, review, qa, light, standard, heavy; model and effort are limited per agent to the values of its scope entry (scripts/check-registry.sh checks the exact model/effort pairs)",
              "minProperties": 1,
              "properties": {
                "claude": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/agent_profiles"
                    },
                    {
                      "additionalProperties": {
                        "properties": {
                          "model": {
                            "enum": [
                              "claude-opus-5-5",
                              "claude-sonnet-5-5"
                            ]
                          },
                          "effort": {
                            "enum": [
                              "medium",
                              "high"
                            ]
                          }
                        }
                      }
                    }
                  ]
                },
                "codex": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/agent_profiles"
                    },
                    {
                      "additionalProperties": {
                        "properties": {
                          "model": {
                            "enum": [
                              "gpt-6.1-sol",
                              "gpt-6.1-terra"
                            ]
                          },
                          "effort": {
                            "enum": [
                              "medium",
                              "high"
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "additionalProperties": {
                "$ref": "#/$defs/agent_profiles"
              }
            },
            "default_grade": {
              "type": "string",
              "enum": [
                "light",
                "standard",
                "heavy"
              ]
            },
            "rubric": {
              "type": "object",
              "description": "one sentence per grade: how a lead grades a task or subtask",
              "required": [
                "light",
                "standard",
                "heavy"
              ],
              "properties": {
                "light": {
                  "type": "string"
                },
                "standard": {
                  "type": "string"
                },
                "heavy": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "subagents": {
          "type": "object",
          "description": "In-session subagent rules (scripts/lib/subagent_policy.py; policy: skills/delivery/references/delivery.md section 8 'In-session subagents'). scripts/check-registry.sh checks the models against pipeline.models.scope and agent_tool_alias.",
          "required": ["description", "forbidden", "roles", "models"],
          "properties": {
            "description": {"type": "string"},
            "forbidden": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "roles": {
              "type": "object",
              "required": ["run_lead", "planner", "lead", "implement", "review", "qa"],
              "properties": {
                "run_lead": {"$ref": "#/$defs/subagent_role"},
                "planner": {"$ref": "#/$defs/subagent_role"},
                "lead": {"$ref": "#/$defs/subagent_role"},
                "implement": {"$ref": "#/$defs/subagent_role"},
                "review": {"$ref": "#/$defs/subagent_role"},
                "qa": {"$ref": "#/$defs/subagent_role"}
              },
              "additionalProperties": false
            },
            "models": {
              "type": "object",
              "required": ["claude", "codex"],
              "properties": {
                "claude": {
                  "type": "object",
                  "required": ["model", "alias", "agent"],
                  "properties": {
                    "model": {"type": "string", "minLength": 1},
                    "alias": {"enum": ["opus", "sonnet", "haiku"]},
                    "agent": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                },
                "codex": {
                  "type": "object",
                  "required": ["model", "effort"],
                  "properties": {
                    "model": {"type": "string", "minLength": 1},
                    "effort": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "global_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "repos": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "default_branch",
          "protected_branches",
          "instructions"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative to the workspace root."
          },
          "remote": {
            "type": [
              "string",
              "null"
            ]
          },
          "default_branch": {
            "type": "string"
          },
          "protected_branches": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Exact names or prefix globs ending in *."
          },
          "branch_pattern": {
            "type": "string"
          },
          "commit_style": {
            "type": "string"
          },
          "merge": {
            "type": "string"
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "embedded_clones": {
            "type": "array",
            "description": "Gitignored nested clones of another registry repo inside this one (user state; never the canonical checkout).",
            "items": {
              "type": "object",
              "required": [
                "path",
                "of"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "of": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "optional": {
            "type": "boolean",
            "description": "When true, the repo may be absent from the workspace; paths are skipped only while absent."
          },
          "worktrees": {
            "type": "boolean",
            "description": "false: never create a worktree of this repo for any pipeline role (Unity projects: each worktree needs its own Library/ import). Tasks run one after another in the main checkout. Default true."
          },
          "worktrees_reason": {
            "type": "string"
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "scope",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "description": "Every skill directory under skills/ must be registered here and vice versa (check-registry.sh).",
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "repos",
          "summary",
          "order"
        ],
        "properties": {
          "kind": {
            "enum": [
              "core",
              "repo",
              "cross-repo",
              "tech"
            ],
            "description": "cross-repo skills drive contracts and orchestrate legs; repo skills implement inside one repo. tech skills hold how a technology works in this workspace; never routed as lead/leg, listed in routing.tech for the skills in used_by."
          },
          "repos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "order": {
            "type": "number",
            "description": "Lead precedence tie-break inside a precedence class (lower wins). Unique across skills."
          },
          "used_by": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "tech skills only: the repo/cross-repo skills whose work needs this technology."
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "tech skills only, optional: list the skill in routing.tech only when a changed file matches one of these module-style paths or `**/*.ext` globs (default: every change in its repos)."
          },
          "cite_roots": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z]+:"
            },
            "description": "Where this skill's `path:line` citations resolve (scripts/checks/skill-citations.py): citation prefix (\"\" = default, \"dots:\", \"backend/\", ...) -> \"<repo key>:<subpath>\". Default \"\" -> the first repo's root; every repo directory name is a prefix already."
          },
          "domain": {
            "type": "string",
            "description": "Owning domain; defaults to engineering."
          },
          "role": {
            "enum": [
              "orchestrator",
              "implementer",
              "reference"
            ],
            "description": "Artifact role inside its domain."
          }
        }
      }
    },
    "human_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "match": {
            "type": "string",
            "description": "Python regex applied by the git guard to each Bash command segment inside the workspace."
          },
          "decision": {
            "enum": [
              "ask",
              "deny"
            ],
            "default": "ask",
            "description": "Advisory level (hooks never ask or block since 1.0.3): ask -> rpg-factory advisory (warn), deny -> rpg-factory advisory (high)."
          },
          "read_only_exempt": {
            "type": "boolean",
            "default": false,
            "description": "The git guard skips this gate when the whole command is read-only (factory_session.is_read_only: cat, grep, sed -n Np, git log ...), so inspecting a gated script gets no advisory. Never set it on a gate about reading (secrets)."
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "source",
          "copies",
          "driver",
          "gate",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/contract_end"
          },
          "copies": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/contract_end"
            },
            "description": "Ends that must change with the source; touching one routes to the driver."
          },
          "upstream": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/contract_end"
            },
            "description": "Where released versions come from (informational, never routes)."
          },
          "watchers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/contract_end"
            },
            "description": "Other consumers pinned independently (informational, never routes)."
          },
          "driver": {
            "type": [
              "string",
              "null"
            ],
            "description": "Skill that leads when this contract is touched (cross-repo drivers always lead; repo drivers lead when the source is touched)."
          },
          "gate": {
            "type": [
              "string",
              "null"
            ],
            "description": "human_gates id raised by this contract."
          },
          "evidence": {
            "type": "string"
          },
          "ordering": {
            "enum": ["ordered", "none"],
            "default": "ordered",
            "description": "none registers a routable synchronization contract for follow-ups and trace evidence without adding a workflow wave edge."
          },
          "domain": {
            "type": "string",
            "description": "Owning domain; defaults to engineering."
          },
          "role": {
            "enum": [
              "orchestrator",
              "implementer",
              "reference"
            ],
            "description": "Artifact role inside its domain."
          }
        }
      }
    },
    "domains": {
      "type": "object",
      "description": "Top-level engineering domains and their ownership, checks, gates and approvers.",
      "additionalProperties": {
        "$ref": "#/$defs/domain"
      }
    }
  },
  "$defs": {
    "subagent_role": {
      "type": "object",
      "required": ["access", "max_parallel", "when"],
      "properties": {
        "access": {"enum": ["none", "read"]},
        "max_parallel": {"type": "integer", "minimum": 0},
        "when": {"type": "string", "minLength": 1},
        "own_model": {"type": "boolean", "description": "true: the subagent runs on the reviewer's own model"}
      },
      "additionalProperties": false
    },
    "agent_profiles": {
      "type": "object",
      "required": [
        "planner",
        "lead",
        "review",
        "qa",
        "light",
        "standard",
        "heavy"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "model",
          "effort"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "run",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "cwd": {
          "type": "string",
          "description": "Repo-relative working directory. Default '.'."
        },
        "run": {
          "type": "string",
          "description": "Command (fast/extended) or instruction (external). Placeholders: {dotnet}, {plugin_root}."
        },
        "trigger": {
          "type": "string",
          "description": "When an extended check becomes required."
        },
        "evidence": {
          "type": "string",
          "description": "What counts as proof. Must name counts where the tool reports them."
        },
        "parser": {
          "type": "string",
          "description": "How run-checks.py grades the output: go-test | dotnet-test | exit | regex:<pattern> (default inferred from the command)."
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Check ids in the same run that must PASS first; otherwise this check is BLOCKED."
        }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "repo",
        "paths",
        "responsibility",
        "depends_on",
        "checks",
        "rules",
        "generated",
        "tools",
        "obligations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+\\.[a-z0-9-]+$"
        },
        "repo": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Repo-relative prefixes. Trailing / = directory. Longest match wins."
        },
        "responsibility": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Module ids this module consumes. A change in any of them makes this module a dependent that must be validated."
        },
        "claude_md": {
          "type": [
            "string",
            "null"
          ]
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changelog": {
          "type": [
            "string",
            "null"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths (or **/*suffix globs) produced by a generator; never hand-edit."
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "object",
          "required": [
            "fast",
            "extended",
            "external"
          ],
          "properties": {
            "fast": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/check"
              }
            },
            "extended": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/check"
              }
            },
            "external": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/check"
              }
            }
          }
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Skills owning this module (registry.skills keys). Drives Suggested Factory skills."
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "human_gates ids raised when this module is touched."
        },
        "fallback": {
          "type": "boolean",
          "description": "Repository-level catch-all (<repo>.root, paths ['./']): files no other module owns route here instead of 'unmapped'."
        },
        "domain": {
          "type": "string",
          "description": "Owning domain; defaults to engineering."
        },
        "role": {
          "enum": [
            "orchestrator",
            "implementer",
            "reference"
          ],
          "description": "Artifact role inside its domain."
        }
      }
    },
    "contract_end": {
      "type": "object",
      "required": [
        "repo",
        "path"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "how": {
          "type": "string"
        }
      }
    },
    "domain": {
      "type": "object",
      "required": [
        "summary",
        "status",
        "lead",
        "repos",
        "artifact_kinds",
        "quality_gates",
        "human_gates",
        "handoffs",
        "may_own_feature_state",
        "approvers"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "planned",
            "foundation"
          ]
        },
        "lead": {
          "type": [
            "string",
            "null"
          ]
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifact_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quality_gates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_gates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "handoffs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "may_own_feature_state": {
          "type": "boolean"
        },
        "approvers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/domain_approver"
          }
        },
        "revoked_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Revoked SSH key fingerprints."
          }
        },
        "reviewers": {
          "type": "array",
          "description": "SSH principals and public keys trusted for signed artifact reviews.",
          "items": {
            "$ref": "#/$defs/domain_approver"
          }
        }
      }
    },
    "domain_approver": {
      "type": "object",
      "required": [
        "principal",
        "ssh_public_key"
      ],
      "properties": {
        "principal": {
          "type": "string"
        },
        "ssh_public_key": {
          "type": "string",
          "pattern": "^ssh-"
        },
        "revoked": {
          "type": "boolean"
        }
      }
    }
  }
}
