 ],
 "component_signals": [
  "\\b(components?|controls?|widgets?)\\b.{0,60}\\b(settings|options|inventory|shop|store|vendor|hud|quests?|journal|pop-?ups?|dialogs?|modals?|menus?|screens?|toolbar|tabs?|tooltips?)\\b",
  "\\b(settings|options|inventory|shop|store|vendor|hud|quests?|journal|pop-?ups?|dialogs?|modals?|menus?)\\b.{0,40}\\b(components?|controls?|widgets?)\\b"
 ],
 "component_guard": [
