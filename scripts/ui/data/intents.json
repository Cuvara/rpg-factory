 ],
 "dependency_signals": [
  "\\b(add|install|bump|upgrade|update|pin|re-?pin|move|remove|uninstall|downgrade)\\b.{0,60}\\b(com\\.cuvara\\.[\\w.]+|ui ?toolkit( package)?|package|dependency)\\b.{0,60}\\b(to|in|into|from|on)\\b.{0,40}\\b(client|project|manifest|packages|v\\d+\\.\\d+)",
  "\\b(bump|upgrade|downgrade|re-?pin)\\b.{0,40}\\b(com\\.cuvara\\.[\\w.]+|ui ?toolkit|package|pin)\\b",
  "\\bmanifest\\.json\\b",
  "\\bpackages-lock\\.json\\b",
  "\\bpackage (pin|dependency|version)\\b"
 ],
 "dependency_names": [
  "com\\.cuvara\\.[\\w.]*\\w",
  "\\bui ?toolkit( package)?\\b",
  "\\bpackages/manifest\\.json\\b"
 ]
}
