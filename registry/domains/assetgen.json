{
  "modules": [
    {
      "id": "authoring.assetgen",
      "repo": "authoring",
      "paths": [
        "assetgen/"
      ],
      "responsibility": "AI image generation: the game layer of asset-gen purposes, styles and ComfyUI workflow templates, and generation run records (gen-run) with prompt, reviews, QA and output hashes.",
      "depends_on": [],
      "rules": [
        "Approval of a gen-run is human-only (gate assetgen-approval): an agent runs assetgen.py approve-record only on the person's explicit word (quoted), never approves on its own, and the person commits run.md and the approval record in one signed commit.",
        "The prompt and image reviews come from a model other than the prompt author; a same-model review is an explicit SAME_MODEL fallback, never a silent pass.",
        "No credentials, endpoints or provider URLs in templates or run records; the ComfyUI node reads its own credentials."
      ],
      "generated": [],
      "tools": [],
      "checks": {
        "fast": [
          {
            "id": "artifact-lint",
            "run": "python3 -B {plugin_root}/scripts/checks/artifact-lint.py . --registry {plugin_root}/registry.json",
            "evidence": "Artifact schema and lifecycle validation."
          },
          {
            "id": "artifact-trace",
            "run": "python3 -B {plugin_root}/scripts/checks/artifact-trace.py . --registry {plugin_root}/registry.json",
            "evidence": "Artifact trace and approvals validation."
          },
          {
            "id": "assetgen-quality",
            "run": "python3 -B {plugin_root}/scripts/checks/artifact-quality.py . --registry {plugin_root}/registry.json --domain assetgen",
            "evidence": "Generation runs: reviewer model differs from the prompt author, QA PASS recorded, output hashes match the files, provenance complete, purpose/style/template refs resolve."
          },
          {
            "id": "assetgen-lint",
            "run": "python3 -B {plugin_root}/scripts/assetgen/assetgen.py lint --authoring .",
            "evidence": "Game-layer asset-gen data offline: purposes, styles, templates, assetgen/project.json, anchors (an active anchor needs a person's approval, its image hash and an approved source gen-run with a run.md) and rejections; no URL or credential."
          }
        ],
        "extended": [],
        "external": []
      },
      "skills": [
        "asset-gen"
      ],
      "gates": [],
      "obligations": [],
      "domain": "assetgen",
      "docs": []
    }
  ],
