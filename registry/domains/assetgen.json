  "artifact_lifecycles": {
    "gen-run": {
      "states": [
        "draft",
        "review",
        "approved",
        "in-implementation",
        "verified",
        "released",
        "deprecated",
        "proposed",
        "reviewed",
        "blocked",
        "rejected",
        "superseded"
      ],
      "transitions": {
        "draft": [
          "proposed",
          "review"
        ],
        "proposed": [
          "reviewed",
          "approved",
          "rejected",
          "blocked"
        ],
        "review": [
          "reviewed",
          "approved",
          "rejected",
          "blocked"
        ],
        "reviewed": [
          "approved",
          "rejected",
          "blocked",
          "draft"
        ],
        "approved": [
          "in-implementation",
          "draft",
          "blocked"
        ],
        "in-implementation": [
          "verified",
          "draft",
          "blocked",
          "rejected"
        ],
        "verified": [
          "released",
          "draft",
          "blocked"
        ],
        "released": [
          "deprecated",
          "superseded"
        ],
        "rejected": [
          "draft"
        ],
        "blocked": [
          "draft"
        ],
        "deprecated": [],
        "superseded": []
      },
      "requirements": {
        "approved": {
          "needs_approval": [
            "assetgen-approval"
          ]
        },
        "in-implementation": {
          "needs_trace": [
            "impl"
          ]
        },
        "verified": {
          "coverage_by_acceptance": true,
          "verify_type_coverage": {
            "test": {
              "needs_trace": [
                "impl",
                "test"
              ]
            },
            "review": {
              "needs_review": true
            },
            "measure": {
              "needs_evidence": true
            }
          }
        },
        "released": {
          "needs_trace": [
            "release"
          ],
          "requires_approved_verified": true
        },
        "proposed": {
          "schema_complete": true,
          "acceptance": true
        },
        "reviewed": {
          "independent_review": true
        },
        "rejected": {
          "rejection_record": true
        },
        "blocked": {
          "blocked_by": true
        }
      }
    }
  },
