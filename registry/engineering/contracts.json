        "repo": "server",
        "path": "backend/shared/proto/wire.proto"
      },
      "copies": [
        {
          "repo": "server",
          "path": "backend/shared/proto/gen/",
          "how": "backend/shared/proto/generate.sh (protoc + protoc-gen-go at the CI pins)"
        },
        {
          "repo": "server",
          "path": "backend/gameserver-dotnet/GameServer/Net/Generated/",
          "how": "generate.sh"
        },
        {
          "repo": "netcode",
          "path": "Runtime/Protocol/Generated/Wire.cs",
          "how": "byte copy of the server C# binding"
        }
      ],
      "driver": "wire-contract",
      "gate": "tag",
      "evidence": "scripts/checks/wire-parity.sh; server CI proto-generated; Netcode CI wire; TestDotnetInterop."
    },
