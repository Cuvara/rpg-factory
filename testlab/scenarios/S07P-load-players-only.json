{
  "schema": "rpg.testlab.scenario.v1",
  "id": "S07P",
  "version": 3,
  "title": "Sustained load, players only (enemy AI off): network and replication capacity",
  "description": "As S07 with GAMESERVER_ENEMIES=false, so the population is exactly the bots plus three rendered players. Separates player capacity from the enemy population, which scales 45 per player when enemies are on. Same ADR-7 caveat. GAMESERVER_CAPACITY is raised to 1000 so levels above 100 measure the server, not the default 100-player cap.",
  "clients": 3,
  "map": "map_01",
  "seed": 7,
  "duration_s": 60,
  "join_timeout_s": 180,
  "bots": {
    "players": 0,
    "movement": "cluster",
    "ramp_per_s": 20
  },
  "screenshots_s": [
    30
  ],
  "per_client": [
    {
      "steps": []
    },
    {
      "steps": [
        {
          "t0": 2,
          "t1": 43,
          "mode": "circle",
          "rate": 0.8
        }
      ]
    },
    {
      "steps": [],
      "actions": []
    }
  ],
  "assertions": [
    {
      "id": "in_world",
      "check": "clients_in_world"
    },
    {
      "id": "completed",
      "check": "clients_completed"
    },
    {
      "id": "logs_clean",
      "check": "client_log_clean"
    },
    {
      "id": "bots",
      "check": "bots_joined"
    },
    {
      "id": "tick",
      "check": "server_tick"
    },
    {
      "id": "kcp",
      "check": "kcp_health"
    },
    {
      "id": "snapshots",
      "check": "snapshot_cadence",
      "max_gap_ms": 250
    },
    {
      "id": "replication_gap",
      "check": "snapshot_update_gap",
      "max_gap_ms": 200
    },
    {
      "id": "frames",
      "check": "frame_time",
      "p95_ms": 33.4,
      "p99_ms": 50
    },
    {
      "id": "render_jumps",
      "check": "render_jumps",
      "max_local": 0,
      "max_remote_per_client_min": 2.0
    },
    {
      "id": "memory",
      "check": "memory_growth",
      "max_server_mib_per_min": 20,
      "informational": true
    },
    {
      "id": "snapshot_order",
      "check": "snapshot_order",
      "title": "received world ticks never go backwards or repeat within a session"
    }
  ],
  "server_env": {
    "GAMESERVER_ENEMIES": "false",
    "GAMESERVER_CAPACITY": "1000"
  }
}
