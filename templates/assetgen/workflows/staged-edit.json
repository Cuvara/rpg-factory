{
  "schema": "rpg-factory.comfy-template/1",
  "title": "Staged image edit",
  "description": "Edit a reference image in stages with a reviewed prompt and one saved output.",
  "params": {
    "prompt": {
      "type": "string",
      "required": true,
      "description": "Final reviewed prompt (filled from --prompt-file)."
    },
    "model": {
      "type": "string",
      "default": "cx/gpt-5.6-sol-image",
      "description": "Image model id served through the NineRouterImage node."
    },
    "size": {
      "type": "enum",
      "options": [
        "auto",
        "1024x1024",
        "1536x1024",
        "1024x1536"
      ],
      "default": "1024x1024",
      "description": "Requested size; the gateway may return another size (QA checks per purpose)."
    },
    "quality": {
      "type": "enum",
      "options": [
        "auto",
        "low",
        "medium",
        "high"
      ],
      "default": "auto",
      "description": "Image quality."
    },
    "background": {
      "type": "enum",
      "options": [
        "auto",
        "opaque",
        "transparent"
      ],
      "default": "auto",
      "description": "Background mode."
    },
    "filename_prefix": {
      "type": "string",
      "default": "assetgen/run",
      "description": "SaveImage filename prefix in the ComfyUI output folder."
    },
    "reference_image": {
      "type": "string",
      "required": true,
      "description": "Name of the reference image in the ComfyUI input folder (comfy-mcp upload_file returns it)."
    }
  },
  "output_node": "3",
  "workflow": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{reference_image}}"
      },
      "_meta": {
        "title": "Reference image"
      }
    },
    "2": {
      "class_type": "NineRouterImage",
      "inputs": {
        "user_prompt": [
          "4",
          0
        ],
        "model": "{{model}}",
        "size": "{{size}}",
        "quality": "{{quality}}",
        "background": "{{background}}",
        "reference_images": [
          "1",
          0
        ]
      },
      "_meta": {
        "title": "Edit image"
      }
    },
    "3": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "{{filename_prefix}}-edit",
        "images": [
          "2",
          0
        ]
      },
      "_meta": {
        "title": "Save edited image"
      }
    },
    "4": {
      "class_type": "PrimitiveStringMultiline",
      "inputs": {
        "value": "{{prompt}}"
      },
      "_meta": {
        "title": "Prompt (Claude, Codex review <state>)"
      }
    }
  },
  "ui": {
    "groups": [
      {
        "title": "Prompt",
        "color": "pale_blue",
        "nodes": [
          "4"
        ]
      },
      {
        "title": "References",
        "color": "cyan",
        "nodes": [
          "1"
        ]
      },
      {
        "title": "Generate",
        "color": "green",
        "nodes": [
          "2"
        ]
      },
      {
        "title": "Output",
        "color": "purple",
        "nodes": [
          "3"
        ]
      }
    ],
    "notes": [
      {
        "text": "The reviewed prompt is filled from prompt.md by render and wired straight into the image node.",
        "group": "Prompt"
      },
      {
        "text": "The reference image named by --param reference_image is uploaded to the ComfyUI input folder. Render batches style-lock anchors after it with ImageBatch into reference_images, keeping this reference first.",
        "group": "References"
      },
      {
        "text": "The one image node reads credentials at run time; they are never stored in the graph.",
        "group": "Generate"
      },
      {
        "text": "The only saved file uses the run prefix plus the -edit suffix.",
        "group": "Output"
      }
    ]
  }
}
