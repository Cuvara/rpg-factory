{
 "schema": "rpg-factory.comfy-template/1",
 "title": "Staged UI element generation",
 "description": "Generate a UI element, preview its corner, and save the full image. Credentials are read by the node at run time, never stored here.",
 "params": {
  "prompt": {
   "type": "string",
   "required": true,
   "description": "Final reviewed prompt (filled from --prompt-file)."
  },
  "model": {
   "type": "string",
   "default": "cx/gpt-5.6-sol-image",
   "description": "Image model id served through the NineRouterImage node."
  },
  "size": {
   "type": "enum",
   "options": [
    "auto",
    "1024x1024",
    "1536x1024",
    "1024x1536"
   ],
   "default": "1024x1024",
   "description": "Requested size; the gateway may return another size (QA checks per purpose)."
  },
  "quality": {
   "type": "enum",
   "options": [
    "auto",
    "low",
    "medium",
    "high"
   ],
   "default": "auto",
   "description": "Image quality."
  },
  "background": {
   "type": "enum",
   "options": [
    "auto",
    "opaque",
    "transparent"
   ],
   "default": "auto",
   "description": "Background mode."
  },
  "filename_prefix": {
   "type": "string",
   "default": "assetgen/run",
   "description": "SaveImage filename prefix in the ComfyUI output folder."
  }
 },
 "output_node": "2",
 "workflow": {
  "1": {
   "class_type": "NineRouterImage",
   "inputs": {
    "user_prompt": [
     "3",
     0
    ],
    "model": "{{model}}",
    "size": "{{size}}",
    "quality": "{{quality}}",
    "background": "{{background}}"
   },
   "_meta": {
    "title": "Generate UI element"
   }
  },
  "2": {
   "class_type": "SaveImage",
   "inputs": {
    "filename_prefix": "{{filename_prefix}}-ui",
    "images": [
     "1",
     0
    ]
   },
   "_meta": {
    "title": "Save UI element"
   }
  },
  "3": {
   "class_type": "PrimitiveStringMultiline",
   "inputs": {
    "value": "{{prompt}}"
   },
   "_meta": {
    "title": "Prompt (Claude, Codex review <state>)"
   }
  },
  "4": {
   "class_type": "ImageCrop",
   "inputs": {
    "image": [
     "1",
     0
    ],
    "width": 256,
    "height": 256,
    "x": 0,
    "y": 0
   },
   "_meta": {
    "title": "Crop top-left corner"
   }
  },
  "5": {
   "class_type": "PreviewImage",
   "inputs": {
    "images": [
     "4",
     0
    ]
   },
   "_meta": {
    "title": "Preview corner (nine-slice border)"
   }
  }
 },
 "ui": {
  "groups": [
   {
    "title": "Prompt",
    "color": "pale_blue",
    "nodes": [
     "3"
    ]
   },
   {
    "title": "Generate",
    "color": "green",
    "nodes": [
     "1"
    ]
   },
   {
    "title": "Post-process",
    "color": "yellow",
    "nodes": [
     "4"
    ]
   },
   {
    "title": "Preview",
    "color": "blue",
    "nodes": [
     "5"
    ]
   },
   {
    "title": "Output",
    "color": "purple",
    "nodes": [
     "2"
    ]
   }
  ],
  "notes": [
   {
    "text": "The reviewed prompt guides generation.",
    "group": "Prompt"
   },
   {
    "text": "Generate the full UI element.",
    "group": "Generate"
   },
   {
    "text": "Crop the corner for inspection.",
    "group": "Post-process"
   },
   {
    "text": "Inspect the corner and border for nine-slicing.",
    "group": "Preview"
   },
   {
    "text": "Save the full generated image.",
    "group": "Output"
   }
  ]
 }
}
