    {"id": "toggle", "need": "music toggle", "status_in": ["compose"], "choice_contains": ["Toggle"]},
    {"id": "volume", "need": "volume slider", "status_in": ["compose"], "choice_contains": ["Slider"]},
    {"id": "graphics-quality", "need": "graphics quality", "status_in": ["compose", "configure"], "choice_contains": ["DropdownField"]},
    {"id": "tabs", "need": "tabs", "status_in": ["compose"], "choice_contains": ["TabView"]},
    {"id": "toast", "need": "toast", "status_in": ["reuse"], "choice_contains": ["ToastService"]},
    {"id": "back", "need": "back navigation", "status_in": ["reuse"], "choice_contains": ["PopAsync|BackNavigationSource|IScreenNavigator"]},
    {"id": "theme", "need": "theme", "status_in": ["reuse"], "choice_contains": ["CuvaraThemeService"]},
    {"id": "invented-wheel", "need": "radial weapon wheel", "status_in": ["missing"], "owner_in": ["unity-package", "client-integration"]},
