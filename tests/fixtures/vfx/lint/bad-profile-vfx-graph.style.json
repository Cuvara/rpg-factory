    },
    "color_space": "srgb",
    "linear_textures": ["*_Mask.png", "*_Noise.png", "*_Flow.png"]
  },
  "outputs": {
    "types": ["VFXPlanarPrimitiveOutput", "VFXQuadStripOutput"],
    "blend_modes": ["Additive", "AlphaPremultiplied", "Alpha"],
    "shaders": ["Hidden/VFX/*"]
  },
  "budgets": {
    "android": {"max_alive_particles": 2000, "max_systems": 4, "max_texture_memory_bytes": 4194304},
    "webgl": {"max_alive_particles": 3000, "max_systems": 4, "max_texture_memory_bytes": 4194304},
    "windows": {"max_alive_particles": 10000, "max_systems": 8, "max_texture_memory_bytes": 16777216}
  },
  "capture": {
    "camera": "gameplay",
    "lighting": "dusk",
    "seed": 1234
  },
  "notes": [
    "Fire reads warm at the core and cools to smoke; keep the smoke below the bloom threshold."
  ]
}
