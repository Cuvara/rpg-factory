{
  "purpose": "Fixture style profile for the vfx-production suite: a realistic-style project whose fire-burst effect passes every lint rule.",
  "assetgen_style": "realistic-pbr",
  "vfx_graph": "latest",
  "palette": {
    "hue_tolerance_degrees": 15,
    "elements": {
      "fire": {
        "colors": {
          "ember_core": "#FFE2A8",
          "flame_orange": "#FF8A2A",
          "deep_red": "#C8321E",
          "smoke": "#3A3430"
        },
        "ramp": ["ember_core", "flame_orange", "deep_red", "smoke"]
      },
      "lightning": {
        "colors": {
          "arc_white": "#F2F6FF",
          "arc_blue": "#6FA8FF",
          "arc_violet": "#7A4DFF"
        },
        "ramp": ["arc_white", "arc_blue", "arc_violet"]
      }
    }
  },
  "hdr_intensity": {
    "primary": {"min": 1.0, "max": 4.0},
    "secondary": {"min": 0.5, "max": 2.5},
    "ambient": {"min": 0.0, "max": 1.0}
  },
  "timing": {
    "anticipation": {"min": 0.0, "max": 0.25},
    "impact": {"min": 0.1, "max": 0.4},
    "dissipation": {"min": 0.35, "max": 0.8},
    "sum_tolerance_seconds": 0.05
  },
  "textures": {
    "max_size": 512,
    "flipbook_grids": ["2x2", "4x4", "8x8"],
    "channel_packing": {
