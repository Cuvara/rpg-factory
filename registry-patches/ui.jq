.domains.ui = {"summary":"Production UI/UX requirements, architecture, screens, components, tokens and handoffs.","status":"active","lead":"ui-ux","repos":["authoring"],"artifact_kinds":["ui-flow","ui-spec","ux-requirements","ia-map","screen-spec","component-spec","design-tokens","ui-handoff"],"quality_gates":["artifact-lint","artifact-trace","ui-quality"],"human_gates":[],"handoffs":["feature-spec-to-ui-spec","ui-spec-to-art2d-brief","ui-spec-to-client"],"may_own_feature_state":false,"approvers":[],"quality_plugin":"scripts/checks/domains/ui.py"} | .modules = [.modules[] | if .id == "authoring.ui-flow" or .id == "authoring.ui-spec" then .responsibility = "UI/UX production artifacts, flows and specifications." | .checks.fast += [{"id":"ui-quality","run":"python3 -B {plugin_root}/scripts/checks/artifact-quality.py . --registry {plugin_root}/registry.json --domain ui","evidence":"UI production quality plugin."}] else . end] + [{"id":"authoring.ui-production","repo":"authoring","paths":["ui/"],"responsibility":"Production UI/UX artifact paths.","depends_on":[],"rules":[],"generated":[],"tools":[],"checks":{"fast":[{"id":"ui-quality","run":"python3 -B {plugin_root}/scripts/checks/artifact-quality.py . --registry {plugin_root}/registry.json --domain ui","evidence":"UI production quality plugin."},{"id":"artifact-lint","run":"python3 -B {plugin_root}/scripts/checks/artifact-lint.py . --registry {plugin_root}/registry.json","evidence":"Artifact schema and lifecycle validation."},{"id":"artifact-trace","run":"python3 -B {plugin_root}/scripts/checks/artifact-trace.py . --registry {plugin_root}/registry.json","evidence":"Artifact trace and approvals validation."}],"extended":[],"external":[]},"skills":["ui-ux"],"gates":[],"obligations":[],"domain":"ui","docs":[]}] | .contracts = [.contracts[] | if .id == "feature-spec-to-ui-spec" then .summary = "Design feature specification sources goals and constraints for UI requirements." | .copies += [{"repo":"authoring","path":"ui/requirements/"}] elif .id == "ui-spec-to-art2d-brief" then .summary = "UI screens and components provide visual requirements for art briefs." | .source.path = "ui/specs/" elif .id == "ui-spec-to-client" then .summary = "UI handoff routes screen acceptance to client UI implementation." | .source.path = "ui/specs/" | .copies = [{"repo":"client","path":"Assets/Scripts/UI/"},{"repo":"client","path":"Assets/Scripts/"}] else . end] | .kind_schemas["ux-requirements"] = "docs/schemas/kinds/ux-requirements.schema.json" | .artifact_lifecycles["ux-requirements"] = .artifact_lifecycles.default | .kind_schemas["ia-map"] = "docs/schemas/kinds/ia-map.schema.json" | .artifact_lifecycles["ia-map"] = .artifact_lifecycles.default | .kind_schemas["screen-spec"] = "docs/schemas/kinds/screen-spec.schema.json" | .artifact_lifecycles["screen-spec"] = .artifact_lifecycles.default | .kind_schemas["component-spec"] = "docs/schemas/kinds/component-spec.schema.json" | .artifact_lifecycles["component-spec"] = .artifact_lifecycles.default | .kind_schemas["design-tokens"] = "docs/schemas/kinds/design-tokens.schema.json" | .artifact_lifecycles["design-tokens"] = .artifact_lifecycles.default | .kind_schemas["ui-handoff"] = "docs/schemas/kinds/ui-handoff.schema.json" | .artifact_lifecycles["ui-handoff"] = .artifact_lifecycles.default
